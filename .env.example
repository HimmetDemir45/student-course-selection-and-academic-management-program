# --- Django ---
# UYARI: Asla gercek uretim sifrelerini bu dosyaya veya repoya koymayin. Yerel icin rastgele / dummy kullanin.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-for-local-dev
# Eski anahtar adlari (opsiyonel geriye donuk):
# SECRET_KEY=...
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Log seviyesi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Yapilandirilmis JSON log (CloudWatch/Loki); prod onerisi True
# DJANGO_LOG_JSON=False

# Enrollment POST rate limit (django-ratelimit); testlerde CI/dev kapali
# RATELIMIT_ENABLE=True
# FEATURE_ENROLLMENT_RATELIMIT=True

# --- Veritabani (bir yontem secin) ---
# Tek satir URL (Docker / RDS icin uygun):
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/university_db
# Veya ayrik MySQL alanlari:
DB_NAME=university_db
DB_USER=root
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Docker Compose (local mysql servisi) ---
MYSQL_DATABASE=university_db
MYSQL_ROOT_PASSWORD=devroot
MYSQL_USER=app
MYSQL_PASSWORD=appsecret

# --- E-posta (parola sifirlama icin) ---
# Bu degiskenler tanimli degilse Django console backend'ine duser
# (e-postalar log'a yazilir, kullaniciya GONDERILMEZ).
# Gmail icin: hesabinizda 2FA acin ve uygulamaya ozel sifre (App Password) olusturun.
# https://support.google.com/accounts/answer/185833
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
# EMAIL_TIMEOUT=15

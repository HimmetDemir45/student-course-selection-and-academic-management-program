# Production ornek ortam dosyasi (.env.production olarak kopyalayin; repoya commit etmeyin)
# Tum degerler ORNEKTIR — gercek sifre/endpoint Secrets Manager veya guvenli env ile enjekte edilmelidir.

DJANGO_SETTINGS_MODULE=config.settings.prod

# Zorunlu
DJANGO_SECRET_KEY=generate-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# RDS / MySQL (zorunlu prod ayarinda) — USER:PASSWORD yer tutucu
DATABASE_URL=mysql://USER:PASSWORD@your-rds-endpoint.region.rds.amazonaws.com:3306/university_db

# Reverse proxy (ALB/Nginx) — gerektiginde False yapin
# DJANGO_USE_X_FORWARDED_HOST=True

# S3 static + media (django-storages)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=your-static-media-bucket
AWS_S3_REGION_NAME=eu-central-1
# CloudFront veya bucket domain (opsiyonel)
# AWS_S3_CUSTOM_DOMAIN=d123456.cloudfront.net

# Opsiyonel: SMTP
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# ...

LOG_LEVEL=INFO

# Gunicorn (Docker entrypoint)
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120
